{% extends 'base.html.twig' %}

{% block header %}
    Gestion des semestres des étudiants
{% endblock %}

{% block content %}
    <div class="card">
        <div class="card-body">
            <table class="table">
                <thead>
                <tr>
                    <th>Étudiant</th>
                    <th>Semestre</th>
                    <th>Année Universitaire</th>
                    <th>Actions</th>
                </tr>
                </thead>
                <tbody>
                {% for entry in entries %}
                    <tr>
                        <td>{{ entry.etudiant.nom }} {{ entry.etudiant.prenom }}</td>
                        <td>{{ entry.semestre.libelle }}</td>
                        <td>
                            <select class="form-control annee-select"
                                    data-controller="annee-select"
                                    data-action="change->annee-select#change"
                                    data-annee-select-url-value="{{ path('administration_etudiant_semestre_annee_edit_ajax', {id: 'ID'}) }}"
                                    data-annee-select-id-value="{{ entry.id }}">
                                {% for annee in anneeUniversitaires %}
                                    <option value="{{ annee.id }}"
                                            {% if annee.id == entry.anneeUniversitaire.id %}selected{% endif %}>
                                        {{ annee.libelle }}
                                    </option>
                                {% endfor %}
                            </select>
                        </td>
                        <td>
                            <form method="post"
                                  action="{{ path('administration_etudiant_semestre_annee_delete', {id: entry.id}) }}"
                                  onsubmit="return confirm('Êtes-vous sûr ?');" style="display:inline-block;">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ entry.id) }}">
                                <button class="btn btn-sm btn-danger">Supprimer</button>
                            </form>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
